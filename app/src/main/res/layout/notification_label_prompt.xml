<?xml version="1.0" encoding="utf-8"?>
<!-- "Cosa stai facendo?" expanded view: six one-tap labels in two rows (RemoteViews-safe widgets only). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_prompt_title"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button android:id="@+id/label_btn_1" style="@style/LabelPromptButton" />
        <Button android:id="@+id/label_btn_2" style="@style/LabelPromptButton" />
        <Button android:id="@+id/label_btn_3" style="@style/LabelPromptButton" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/label_btn_4" style="@style/LabelPromptButton" />
        <Button android:id="@+id/label_btn_5" style="@style/LabelPromptButton" />
        <Button android:id="@+id/label_btn_6" style="@style/LabelPromptButton" />
    </LinearLayout>
</LinearLayout>
